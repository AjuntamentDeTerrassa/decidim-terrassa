<%#
  OVERRIDE of decidim-core's app/views/decidim/manifests/show.json.erb (copied from v0.30.9).
  Only change vs upstream: the four icon "src" values are wrapped in `raw`.

  Reason: this is a JSON template rendered through ActionView, which auto-escapes `<%= %>`
  output. The favicon `variant_url` returns a signed Active Storage URL containing "&" in its
  query string, which gets escaped to "&amp;", producing an invalid manifest and broken PWA
  icons. `raw` emits the system-generated URL verbatim. Deface can't fix this (it only
  processes :html templates), so we override the view directly.

  UPGRADE NOTE: this is a pinned copy. When bumping decidim-core, diff this file against the
  gem's show.json.erb and re-sync any upstream changes, keeping the `raw` wrapping.
%>
{
  "name": "<%= organization_params.html_name %>",
  "lang": "<%= organization_params.default_locale %>",
  "description": "<%= organization_params.translated_description %>",
  "display": "<%= organization_params.pwa_display %>",
  "start_url": "<%= organization_params.start_url %>",
  "theme_color": "<%= organization_params.colors["primary"] %>",
  "background_color": "#FFFFFF",
  "icons": [
    {
      "src": "<%= raw current_organization.attached_uploader(:favicon).variant_url :small %>",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "<%= raw current_organization.attached_uploader(:favicon).variant_url :medium %>",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "<%= raw current_organization.attached_uploader(:favicon).variant_url :big %>",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "<%= raw current_organization.attached_uploader(:favicon).variant_url :huge %>",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
